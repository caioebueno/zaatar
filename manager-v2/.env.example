# API server base URL — used by the browser, so it must be NEXT_PUBLIC_*
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# File/image host — serves bucket proxy paths (`/api/bucket/<key>`) as public URLs.
# Used to render product images and to absolutize URLs sent on product update.
NEXT_PUBLIC_FILE_API_BASE_URL=https://s3-public-presigner-production-83b6.up.railway.app

# Square OAuth redirect URI (public — e.g. an ngrok tunnel to the API). Square
# redirects the browser here after consent; the API completes the exchange.
# Defaults to <NEXT_PUBLIC_API_BASE_URL>/integrations/square/oauth/exchange.
NEXT_PUBLIC_SQUARE_REDIRECT_URI=https://<your-tunnel>.ngrok-free.app/integrations/square/oauth/exchange

