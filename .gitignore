node_modules
# Keep environment variables out of version control
.env
.wwebjs_auth
.wwebjs_cache
assets
# `assets` above is meant for the root media dir, but it matches any directory
# with that name — driver-app's app icons/splash are real source assets and must
# stay in version control (EAS Build filters uploads through .gitignore).
!driver-app/assets
!driver-app/assets/**
/src/generated/prisma

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

