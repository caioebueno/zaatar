# API server base URL — used by the browser, so it must be NEXT_PUBLIC_*
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Public base for bucket files: the API's GET /files route (same value as the
# API's BUCKET_PUBLIC_BASE_URL). Defaults to <NEXT_PUBLIC_API_BASE_URL>/files.
NEXT_PUBLIC_FILE_API_BASE_URL=http://localhost:4000/files

# Square OAuth redirect URI (public — e.g. an ngrok tunnel to the API). Square
# redirects the browser here after consent; the API completes the exchange.
# Defaults to <NEXT_PUBLIC_API_BASE_URL>/integrations/square/oauth/exchange.
NEXT_PUBLIC_SQUARE_REDIRECT_URI=https://<your-tunnel>.ngrok-free.app/integrations/square/oauth/exchange


# Customer menu (the `web` project). "Preview menu" on Products opens
# <this>/menu/en?menuId=<id> in a new tab. Unset → the button is disabled.
NEXT_PUBLIC_MENU_BASE_URL=http://localhost:3001
